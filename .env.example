# Firebase / Google Cloud — one project for everything (Auth, Firestore,
# Storage, Vertex AI, Cloud Run, Firebase Hosting)
FIREBASE_PROJECT_ID=your-firebase-project-id
GCP_PROJECT_ID=your-firebase-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json   # local dev only; Cloud Run uses its service identity

# Free tier
FREE_TIER_MONTHLY_SCAN_LIMIT=5

# Razorpay — Phase 4
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Plaid — Phase 3 (US bank linking)
PLAID_CLIENT_ID=
PLAID_SECRET=

# Account Aggregator — Phase 3 (India bank linking)
AA_CLIENT_ID=
AA_CLIENT_SECRET=

# Web app (Firebase Hosting + Next.js)
NEXT_PUBLIC_API_URL=https://your-cloud-run-service-url
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Mobile app (Expo)
EXPO_PUBLIC_API_URL=https://your-cloud-run-service-url
EXPO_PUBLIC_FIREBASE_API_KEY=
